  "nodes": [
    {
      "id": "domain-hub",
      "type": "text",
      "text": "# Local/Edge LLM\n\n목표: 경량 모델 실배포 + 에이전트 메모리\n\n[[local-llm]]",
      "x": -100,
      "y": -60,
      "width": 240,
      "height": 120,
      "color": "2"
    },
    {
      "id": "cluster-models",
      "type": "text",
